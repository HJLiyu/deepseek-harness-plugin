{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-deepseek-harness": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": { "HARNESS_INLINE_WORKER": "1" },
      "env_vars": ["CODEX_APP_TOOLS_PIPE_PATH", "CODEX_THREAD_ID", "HOME", "USERPROFILE", "LOCALAPPDATA", "PATH", "OPENAI_API_KEY", "DEEPSEEK_API_KEY", "OLLAMA_API_KEY"]
    }
  }
}
